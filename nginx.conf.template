events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    # Stream logs to stdout and stderr so Railway shows them in real-time
    access_log /dev/stdout;
    error_log /dev/stderr info;

    # Real IP resolution behind Railway / Reverse Proxy
    set_real_ip_from 0.0.0.0/0;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    # Map X-Forwarded-Proto header, falling back to $scheme
    map $http_x_forwarded_proto $proxy_x_forwarded_proto {
        default $http_x_forwarded_proto;
        ''      $scheme;
    }

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types
        text/plain
        text/css
        text/xml
        text/javascript
        application/javascript
        application/xml+rss
        application/json;

    server {
        # Bind dynamically to Railway's $PORT as well as 80, 8080, 3000
        ${LISTEN_PORTS}
        server_name _;
        root /usr/share/nginx/html;
        index index.html;

        # Body buffer and upload limits
        client_max_body_size 50M;
        client_body_buffer_size 128k;

        # Security headers (OWASP Recommended)
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-XSS-Protection "1; mode=block" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

        # Cache static assets
        location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
            expires 1y;
            add_header Cache-Control "public, immutable";
        }

        # Django collectstatic static files
        location ^~ /static/ {
            alias /app/backend/staticfiles/;
            expires 30d;
            add_header Cache-Control "public, max-age=2592000";
            try_files $uri @backend_upstream;
        }

        location @backend_upstream {
            proxy_pass http://${BACKEND_UPSTREAM};
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
            proxy_set_header X-Forwarded-Host $host;
        }

        # Proxy API requests to backend
        location /api/ {
            proxy_pass http://${BACKEND_UPSTREAM};
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
            proxy_set_header X-Forwarded-Host $host;
            proxy_connect_timeout 10s;
            proxy_read_timeout 120s;
            proxy_send_timeout 120s;
        }

        # Proxy Django Admin to backend
        location /admin/ {
            proxy_pass http://${BACKEND_UPSTREAM};
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
            proxy_set_header X-Forwarded-Host $host;
            proxy_connect_timeout 10s;
            proxy_read_timeout 120s;
            proxy_send_timeout 120s;
        }

        # Handle favicon.ico fallback to favicon.svg
        location = /favicon.ico {
            try_files /favicon.svg =204;
            access_log off;
            log_not_found off;
        }

        # Dev HMR / WebSocket fallback (prevents errors from external extensions/HMR/reload.js)
        location ~* (?:^|/)ws(?:/|$) {
            access_log off;
            return 200 "ok\n";
        }

        # Health check for Railway edge / deploy verification
        location ~ ^/health/?$ {
            access_log off;
            return 200 "healthy\n";
            add_header Content-Type text/plain;
        }

        # Backend debug
        location = /backend-debug {
            access_log off;
            return 200 "BACKEND_UPSTREAM: ${BACKEND_UPSTREAM}\n";
            add_header Content-Type text/plain;
        }

        # Prevent caching of index.html so browsers immediately fetch fresh deploy hashes
        location = /index.html {
            add_header Cache-Control "no-cache, no-store, must-revalidate" always;
            add_header Pragma "no-cache" always;
            add_header Expires 0 always;
        }

        # Handle client-side routing
        location / {
            try_files $uri $uri/ /index.html;
            add_header Cache-Control "no-cache, no-store, must-revalidate" always;
            add_header Pragma "no-cache" always;
            add_header Expires 0 always;
        }
    }
}
